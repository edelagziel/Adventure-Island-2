# Keep Unity text assets consistent across Windows and other platforms.
* text=auto

*.cs text eol=lf
*.asmdef text eol=lf
*.json text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.shader text eol=lf
*.txt text eol=lf

# Binary Unity assets must never be line-ending normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.psd binary
*.ttf binary
*.otf binary
*.wav binary
*.mp3 binary
*.ogg binary
*.fbx binary
